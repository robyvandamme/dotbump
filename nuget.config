<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="robyvandamme" value="https://nuget.pkg.github.com/robyvandamme/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <!-- dotbump is available on both feeds -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="dotbump" />
    </packageSource>
    <packageSource key="robyvandamme">
      <package pattern="dotbump" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <robyvandamme>
      <add key="Username" value="%PRIVATE_GITHUB_FEED_USER%" />
      <add key="ClearTextPassword" value="%PRIVATE_GITHUB_FEED_PASSWORD%" />
    </robyvandamme>
  </packageSourceCredentials>
</configuration>
